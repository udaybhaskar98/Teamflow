# Optional gateway origin or same-origin prefix. When set, requests use
# <VITE_API_BASE_URL>/api/<service>. Individual VITE_*_API_URL values win.
# For same-origin ingress, set VITE_API_BASE_URL=/
VITE_API_BASE_URL=
VITE_AUTH_API_URL=http://localhost:4001
VITE_ORGANIZATION_API_URL=http://localhost:4002
VITE_PROJECT_API_URL=http://localhost:4003
VITE_TASK_API_URL=http://localhost:4004
VITE_NOTIFICATION_API_URL=http://localhost:4005
VITE_APP_NAME=TeamFlow
