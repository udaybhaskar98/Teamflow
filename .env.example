# TeamFlow local development configuration.
# Copy this file to .env before running Docker Compose or the services locally.

NODE_ENV=development

# PostgreSQL: one server, one schema per service.
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow_dev_password
POSTGRES_DB=teamflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RabbitMQ: used by organization, project, task, and notification services.
RABBITMQ_URL=amqp://teamflow:teamflow_dev_password@localhost:5672
RABBITMQ_DEFAULT_USER=teamflow
RABBITMQ_DEFAULT_PASS=teamflow_dev_password

# Shared application settings. Use a long random JWT secret in real environments.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Host ports for Docker Compose.
FRONTEND_PORT=5173
AUTH_PORT=4001
ORGANIZATION_PORT=4002
PROJECT_PORT=4003
TASK_PORT=4004
NOTIFICATION_PORT=4005

# Internal service URLs used by local npm development.
AUTH_SERVICE_URL=http://localhost:4001
ORGANIZATION_SERVICE_URL=http://localhost:4002
PROJECT_SERVICE_URL=http://localhost:4003
TASK_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# Attachments. STORAGE_DRIVER=local writes to UPLOAD_DIR; s3 uses the AWS SDK.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=attachments/

# Frontend build-time service URLs.
# For a single-origin gateway set VITE_API_BASE_URL=/ and route /api/<service>
# to the matching service. Per-service URLs override the gateway.
VITE_API_BASE_URL=
VITE_AUTH_API_URL=http://localhost:4001
VITE_ORGANIZATION_API_URL=http://localhost:4002
VITE_PROJECT_API_URL=http://localhost:4003
VITE_TASK_API_URL=http://localhost:4004
VITE_NOTIFICATION_API_URL=http://localhost:4005
VITE_APP_NAME=TeamFlow
